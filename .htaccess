Options -Indexes
RewriteEngine On

# Base correcta
RewriteBase /hotel-app/

# Si existe archivo o carpeta, no redirigir
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo pasa al index principal
RewriteRule ^ public/index.php [QSA,L]

# Index por defecto
DirectoryIndex public/index.php